// Prisma Schema for Mankerz Meet (meet.mankerz.xyz)
// Multi-tenant appointment booking SaaS (PostgreSQL / Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("USER") // "USER" | "SUPERADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
  otps    OtpCode[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, used])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String   @unique // Public URL handle: meet.mankerz.xyz/[slug]
  name         String
  title        String   // Profession / Headline
  bio          String?  // Pitch / description
  avatarUrl    String?  // Profile picture URL (Supabase Storage)
  bannerUrl    String?  // Background banner URL (Supabase Storage)
  template     String   @default("MINIMAL_DARK") // "MINIMAL_DARK" | "CLEAN_EDITORIAL"
  whatsapp     String   @default("") // Format with country code (e.g., "5491122334455")
  instagram    String?  // Instagram username without @
  timezone     String   @default("America/Argentina/Buenos_Aires")
  status       String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED" (SuperAdmin billing control)
  slotDuration Int      @default(30) // Booking slot duration in minutes
  bufferTime   Int      @default(0)  // Buffer between slots in minutes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Bank transfer deposit settings to prevent no-shows
  depositRequired    Boolean  @default(false)
  depositPercentage  Int?     // Percentage of service price to request as deposit (e.g. 30%, 50%)
  depositAmount      Int?     // Fixed fallback deposit amount in ARS (e.g. 3000)
  bankAlias          String?  // e.g. "barberia.flow.mp"
  bankCbu         String?  // 22-digit CBU or CVU
  bankHolder      String?  // e.g. "Lucas Gómez - Mercado Pago / Banco Galicia"
  depositNotes    String?  // Custom instructions for the client

  availabilities Availability[]
  services       Service[]
  staffMembers   StaffMember[]
  bookings       Booking[]
}

model StaffMember {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Lucas", "Mateo"
  role        String?  // e.g. "Barbero Principal", "Colorista", "Nail Artist"
  avatarUrl   String?  // Optional staff avatar photo
  email       String?  // Optional email to receive booking notifications
  phone       String?  // Optional phone / WhatsApp
  commissionPercentage Int @default(0) // Commission percentage (e.g. 15, 25, 40)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]

  @@index([profileId, isActive])
}

model Service {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Uñas común", "Uñas con diseño", "Lifting de pestañas"
  description String?
  duration    Int      @default(30) // Duration in minutes
  price       Int?     // Optional price
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([profileId, isActive])
}

model Availability {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime      String   // "09:00"
  endTime        String   // "18:00"
  isActive       Boolean  @default(true)
  breakStartTime String?  // Optional break start (e.g., "13:00")
  breakEndTime   String?  // Optional break end (e.g., "14:00")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([profileId, dayOfWeek])
}

model Booking {
  id              String       @id @default(cuid())
  profileId       String
  profile         Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName     String?      // Snapshot of selected service name
  servicePrice    Int?         // Snapshot of price charged for this appointment
  staffMemberId   String?
  staffMember     StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  staffMemberName String?      // Snapshot of staff member name (e.g. "Lucas")
  customerName    String
  customerEmail   String
  customerPhone   String
  date            String       // "YYYY-MM-DD"
  startTime       String       // "10:00"
  endTime         String       // "10:30"
  notes           String?
  status          String       @default("CONFIRMED") // "CONFIRMED" | "CANCELLED" | "COMPLETED"
  paymentStatus   String       @default("EXEMPT") // "PENDING" | "PAID" | "EXEMPT"
  depositAmount   Int?         // Snapshot of required deposit amount in ARS
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([profileId, date])
  @@index([profileId, staffMemberId, date])
}
